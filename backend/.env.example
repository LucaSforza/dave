DAVE_REDIS_URL=redis://redis:6379/0
DAVE_SSH_HOST=cluster
DAVE_REMOTE_ROOT=dave-cluster
DAVE_SSH_OUTPUT_LIMIT=12582912
DAVE_UID=1000
DAVE_GID=1000
# Compose preserves your host home path inside the image for existing SSH config.
# Optional overrides (use paths from your own SSH configuration, never key contents):
# DAVE_SSH_CONFIG=/home/your-user/.ssh/config
# DAVE_SSH_IDENTITY=/home/your-user/.ssh/id_ed25519
